DATABASE_URL=sqlite:///./data/app.db
SKILLS_STORAGE_DIR=./skills_storage
REDIS_URL=redis://localhost:6379/0

# Azure OpenAI（優先於下面的 OPENAI_BASE_URL）。AZURE_OPENAI_ENDPOINT 若以
# /openai/v1 結尾（Azure OpenAI v1 GA API），不需要另外設定 api-version。
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<azure-resource-key>

# 沒設定 Azure 時的備援：LiteLLM gateway 或其他 OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:4000
OPENAI_API_KEY=sk-litellm-gateway-key

# "openai:xxx" 的 xxx 在 Azure 底下是 deployment name，不是底層模型名
DEFAULT_MODEL=openai:gpt-4o-mini

MAX_SCHEDULES_PER_AGENT=20
SCHEDULER_POLL_INTERVAL_SECONDS=30

# inprocess：FastAPI process 自己輪詢 DB 執行排程，不需要 Redis/Celery（本機/POC 用）
# celery：照 spec §7.1 用 Celery beat + worker（正式環境建議）
# off：排程只會被記錄，不會自動執行
SCHEDULER_BACKEND=inprocess
